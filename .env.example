# Copiar a .env en raíz y completar localmente; nunca versionar secretos reales.
# Solo recursos existentes: revisar inventario y respaldos antes de recrear servicios.
ENVIRONMENT=development
DEBUG=false
PORT=8000

# Administración EXISTENTE: healthchecks/operación, no conexión ordinaria de FastAPI.
# Cambiar estos valores no cambia usuarios/contraseñas de volúmenes ya inicializados.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pokearena_db
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=pokearena_pgmaster_data

# Aplicación: cuentas técnicas separadas de administración, ya provisionadas en 1A.
# Para un entorno nuevo se requiere provisión explícita; copiar este archivo no crea usuarios.
POSTGRES_APP_USER=poke_api_user
POSTGRES_APP_PASSWORD=
# Completar URL con usuario de aplicación y contraseña codificada para URL.
# Esquema requerido: postgresql+asyncpg:// (host local 127.0.0.1:5432).
DATABASE_URL=
# Mantenimiento Alembic: rol separado; en 1B.1 SOLO base aislada pokearena_alembic_*.
# Sin fallback a DATABASE_URL. No configurar con el destino activo pokearena_db.
MIGRATION_DATABASE_URL=

MONGO_USER=mongoadmin
MONGO_PASSWORD=
MONGO_DB=pokearena_catalog
MONGO_PORT=27017
MONGO_VOLUME_NAME=pokearena_mongo_data
# Nombre real obtenido de docker inspect; no inventar un volumen nuevo.
MONGO_CONFIG_VOLUME_NAME=
MONGO_APP_USER=poke_api_mongo
MONGO_APP_PASSWORD=
# Esquema mongodb://; usuario de aplicación y authSource de su base de autenticación.
MONGO_URL=

# Se conserva la red ya existente; no se crea otra topología automáticamente.
DOCKER_NETWORK_NAME=poke-arena_default
DB_CONNECT_TIMEOUT_SECONDS=5

# Ruta relativa resuelta siempre respecto de raíz, sin crear archivos al importar.
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
GOOGLE_OAUTH_CLIENT_ID=
PLATFORM_ADMIN_GOOGLE_SUBJECTS=
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
