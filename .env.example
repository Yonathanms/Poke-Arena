# ==============================================================================
# POKÉ-ARENA - VARIABLES DE ENTORNO (EJEMPLO LOCAL)
# Copia este archivo como '.env' para desarrollo local:
#   copy .env.example .env (en Windows PowerShell / CMD)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General de la Aplicación
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Modo usado por Docker Compose full. Mantener development para pruebas locales.
POKEA_ENVIRONMENT=development
DEBUG=true
APP_NAME="Poké-Arena Backend"
API_V1_PREFIX=/api/v1
PORT=8000

# ------------------------------------------------------------------------------
# 2. Base de Datos Relacional (PostgreSQL 16 - Transaccional ACID)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_DB=pokearena_db

# Puertos expuestos para desarrollo local en Windows:
POSTGRES_MASTER_PORT=5432
POSTGRES_REPLICA_PORT=5433

# Cadenas de conexión SQLAlchemy Asíncrono (asyncpg)
# - Uso local en Windows (desarrollo diario con 'uvicorn'):
DATABASE_WRITE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_2026@localhost:5432/pokearena_db
DATABASE_READ_URL=postgresql+asyncpg://postgres:postgres_secure_pass_2026@localhost:5433/pokearena_db

# - Uso dentro de Docker Compose (modo 'full'):
# DATABASE_WRITE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_2026@postgres-master:5432/pokearena_db
# DATABASE_READ_URL=postgresql+asyncpg://postgres:postgres_secure_pass_2026@postgres-replica:5432/pokearena_db

# ------------------------------------------------------------------------------
# 3. Base de Datos Documental (MongoDB 7 - Proyecciones de Catálogo NoSQL)
# ------------------------------------------------------------------------------
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongo_secure_pass_2026
MONGO_DB=pokearena_catalog
MONGO_PORT=27017

# Cadena de conexión Motor Asíncrono
# - Uso local en Windows:
MONGO_URL=mongodb://mongoadmin:mongo_secure_pass_2026@localhost:27017/pokearena_catalog?authSource=admin

# - Uso dentro de Docker Compose (modo 'full'):
# MONGO_URL=mongodb://mongoadmin:mongo_secure_pass_2026@mongo:27017/pokearena_catalog?authSource=admin

# ------------------------------------------------------------------------------
# 4. Almacenamiento Local de Imágenes (Object Storage simulado)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5

# ------------------------------------------------------------------------------
# 5. Seguridad y CORS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost

# Identity: configurar en Google Cloud el origen frontend y usar el Client ID web.
# La lista contiene subject IDs estables de Google (no correos); nunca acepta roles del cliente.
GOOGLE_OAUTH_CLIENT_ID=
PLATFORM_ADMIN_GOOGLE_SUBJECTS=
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
