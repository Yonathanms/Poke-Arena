# ==============================================================================
# POKÉ-ARENA - CONFIGURACIÓN LOCAL (.env)
# ==============================================================================

# 1. Servidor API (FastAPI)
ENVIRONMENT=development
DEBUG=true
PORT=8000

# 2. Base de Datos Relacional (PostgreSQL en Docker :5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_DB=pokearena_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_2026@localhost:5432/pokearena_db

# 3. Base de Datos Documental (MongoDB en Docker :27017)
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongo_secure_pass_2026
MONGO_DB=pokearena_catalog
MONGO_PORT=27017
MONGO_URL=mongodb://mongoadmin:mongo_secure_pass_2026@localhost:27017/pokearena_catalog?authSource=admin

# 4. Almacenamiento local de imágenes
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5

# 5. Autenticación y CORS
GOOGLE_OAUTH_CLIENT_ID=
PLATFORM_ADMIN_GOOGLE_SUBJECTS=
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
